<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1">
<meta name="theme-color" content="#0f1218">
<title>阅读 · 网页版</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>

<!-- ============ 书架 ============ -->
<div id="shelf" class="view">
  <header class="bar">
    <h1>书架</h1>
    <div class="bar-actions">
      <button id="btnDiscover" class="btn ghost" title="搜索网络小说">🔍</button>
      <button id="btnSources" class="btn ghost" title="书源管理">源</button>
      <button id="btnImport" class="btn primary">＋ 导入</button>
      <button id="btnShelfSet" class="btn ghost" title="设置">⚙</button>
    </div>
  </header>
  <input type="file" id="fileInput" accept=".txt,.epub,text/plain,application/epub+zip" multiple hidden>
  <div id="grid" class="grid"></div>
  <p id="shelfEmpty" class="empty">书架是空的。<br>点右上角「导入」上传 TXT 或 EPUB。</p>
</div>

<!-- ============ 搜索（书源） ============ -->
<div id="discover" class="view hide">
  <header class="bar">
    <button class="btn ghost" id="btnDiscBack">‹</button>
    <input id="searchInput" class="search-input" placeholder="书名 / 作者，回车搜索" autocomplete="off">
    <button class="btn primary" id="btnDoSearch">搜索</button>
  </header>
  <div id="searchStat" class="hint pad"></div>
  <div id="searchRes" class="res-list"></div>
</div>

<!-- ============ 书籍详情 ============ -->
<div id="detail" class="view hide">
  <header class="bar">
    <button class="btn ghost" id="btnDetailBack">‹</button>
    <div class="title" id="detailTitle">书籍详情</div>
  </header>
  <div id="detailBody" class="detail-body"></div>
</div>

<!-- ============ 书源管理 ============ -->
<div id="srcmgr" class="view hide">
  <header class="bar">
    <button class="btn ghost" id="btnSrcBack">‹</button>
    <div class="title">书源</div>
    <button class="btn primary" id="btnSrcImport">导入</button>
  </header>
  <input type="file" id="srcFile" accept=".json,application/json" hidden>
  <div class="src-bar">
    <span id="srcStat" class="hint"></span>
    <button class="btn ghost sm" id="btnSrcExportOn" title="导出启用中的书源，可直接导入「阅读」App">导出启用</button>
    <button class="btn ghost sm" id="btnSrcExportAll" title="导出全部书源（含已停用的）">导出全部</button>
  </div>
  <div id="srcList" class="src-list"></div>
</div>

<!-- ============ 阅读器 ============ -->
<div id="reader" class="view hide">
  <header class="bar top" id="topBar">
    <button class="btn ghost" id="btnBack">‹</button>
    <div class="title" id="bookTitle"></div>
    <button class="btn ghost" id="btnToc">目录</button>
    <button class="btn ghost" id="btnReaderSet">Aa</button>
  </header>

  <main id="content" class="content"></main>

  <footer class="bar bottom" id="bottomBar">
    <button class="btn ghost" id="btnPrev">上一章</button>
    <div class="prog"><span id="progText">0%</span><i id="progBar"></i></div>
    <button class="btn ghost" id="btnNext">下一章</button>
    <button class="btn primary round" id="btnSpeak" title="朗读">▶</button>
  </footer>
</div>

<!-- ============ 目录抽屉 ============ -->
<div id="tocDrawer" class="drawer hide">
  <div class="drawer-head">
    <input id="tocSearch" placeholder="搜索本书内容…">
    <button class="btn ghost" id="btnTocClose">✕</button>
  </div>
  <div id="tocList" class="toc-list"></div>
  <div id="searchHits" class="toc-list hide"></div>
</div>
<div id="mask" class="mask hide"></div>

<!-- ============ 朗读面板 ============ -->
<div id="ttsPanel" class="sheet hide">
  <div class="sheet-grab"></div>
  <div class="tts-row">
    <button class="btn round" id="ttsPrev">⏮</button>
    <button class="btn primary round big" id="ttsPlay">▶</button>
    <button class="btn round" id="ttsNext">⏭</button>
    <div class="tts-info">
      <div id="ttsNow">未开始</div>
      <div id="ttsHint" class="hint"></div>
    </div>
  </div>
  <div class="row">
    <label>语速 <b id="speedVal">1.0</b></label>
    <input type="range" id="ttsSpeed" min="0.6" max="2" step="0.02" value="1.18">
  </div>
  <div class="row">
    <label>引擎</label>
    <select id="ttsEngine">
      <option value="http">HTTP 接口（Fish / 硅基流动 / Azure…）</option>
      <option value="web">浏览器自带语音</option>
    </select>
  </div>
  <div id="webVoiceRow" class="row hide">
    <label>系统音色</label>
    <select id="webVoice"></select>
  </div>
  <div class="row">
    <label>读完自动下一章</label>
    <input type="checkbox" id="ttsAutoNext" class="chk" checked>
  </div>
  <button class="btn wide" id="btnTtsCfg">TTS 接口设置（音色 ID / KEY / 模板）</button>
</div>

<!-- ============ 设置面板 ============ -->
<div id="setPanel" class="sheet hide">
  <div class="sheet-grab"></div>
  <div class="tabs">
    <button class="tab active" data-tab="read">阅读</button>
    <button class="tab" data-tab="tts">朗读</button>
  </div>

  <div id="tab-read" class="tab-body">
    <div class="row"><label>字号 <b id="fsVal"></b></label><input type="range" id="setFontSize" min="14" max="32" step="1"></div>
    <div class="row"><label>行距 <b id="lhVal"></b></label><input type="range" id="setLineHeight" min="1.3" max="2.4" step="0.05"></div>
    <div class="row"><label>边距 <b id="pdVal"></b></label><input type="range" id="setPadding" min="6" max="40" step="2"></div>
    <div class="row">
      <label>翻页方式</label>
      <div class="seg" id="pageModes">
        <button data-pm="scroll">滚动</button>
        <button data-pm="page">整页</button>
        <button data-pm="slide">左右</button>
      </div>
    </div>
    <div class="row"><label>读到底自动接下一章（无跳转）</label><input type="checkbox" id="autoCh" class="chk" checked></div>
    <div class="row"><label>字体</label>
      <select id="setFont">
        <option value="system">系统默认</option>
        <option value="serif">宋体 / 衬线</option>
        <option value="sans">黑体 / 无衬线</option>
        <option value="kai">楷体</option>
      </select>
    </div>
    <div class="row"><label>主题</label>
      <div class="themes" id="themes">
        <button data-theme="light" style="--c:#f7f7f7;--t:#1b1b1b">白</button>
        <button data-theme="sepia" style="--c:#f3e9d6;--t:#4a3f2f">米黄</button>
        <button data-theme="green" style="--c:#dfeee0;--t:#2b3a2c">护眼</button>
        <button data-theme="dark" style="--c:#161a21;--t:#c8ccd4">夜间</button>
        <button data-theme="black" style="--c:#000;--t:#9aa0aa">纯黑</button>
      </div>
    </div>
  </div>

  <div id="tab-tts" class="tab-body hide">
    <div class="row"><label>预设</label><select id="ttsPreset"></select></div>
    <p class="hint" id="presetNote"></p>
    <div class="row col"><label>接口地址 URL</label><input id="ttsUrl" placeholder="https://api.fish.audio/v1/tts"></div>
    <div class="row"><label>方法</label>
      <select id="ttsMethod"><option>POST</option><option>GET</option></select>
    </div>
    <div class="row col"><label>请求头（JSON）</label><textarea id="ttsHeaders" rows="3" spellcheck="false"></textarea></div>
    <div class="row col"><label>请求体模板</label>
      <textarea id="ttsBody" rows="6" spellcheck="false"></textarea>
      <p class="hint">可用占位符：<code>{{text}}</code> 正文（自动转义）、<code>{{text_raw}}</code> 原文、<code>{{voice}}</code> 音色 ID、<code>{{speed}}</code> 语速</p>
    </div>
    <div class="row col"><label>音色 ID（自己填）</label><input id="ttsVoice" placeholder="Fish：音色页地址栏 /model/ 后面那串"></div>
    <div class="row col"><label>代理（本机访问境外接口用）</label><input id="ttsProxy" placeholder="http://127.0.0.1:7890"></div>
    <div class="tts-test">
      <button class="btn" id="btnTestTts">测试发音</button>
      <span id="testResult" class="hint"></span>
    </div>
  </div>

  <button class="btn primary wide" id="btnSaveSet">保存</button>
</div>

<div id="toast" class="toast hide"></div>
<script src="/static/app.js"></script>
</body>
</html>
